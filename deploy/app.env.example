# Install as /etc/yanxiben/app.env, root:yanxi 0640. No shell expansion here.
DATA_DIR=/var/lib/yanxiben/data
AI_KEY_FILE=/etc/yanxiben/secrets/ai-master.key
PUBLIC_ORIGIN=https://study.example.org
SECURE_COOKIES=1
PROXY_SECRET=REPLACE_WITH_RANDOM_48_BYTE_HEX_MATCHING_CADDY
RESTORE_MODE=admin
AI_ENABLED=0
CAPACITY_POLICY=invited

