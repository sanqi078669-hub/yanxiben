{
  "name": "yanxiben",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/build-workers.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/build-workers.mjs && node scripts/build.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:production": "node scripts/verify-production-restore.mjs",
    "test:clean": "node scripts/verify-clean-install.mjs",
    "init": "tsx scripts/init.ts",
    "backup": "tsx scripts/data.ts backup",
    "restore": "tsx scripts/data.ts restore",
    "maintenance": "tsx scripts/maintenance.ts",
    "maintenance:snapshots": "tsx scripts/migration-snapshots.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "c8 node --import tsx --test tests/*.test.ts && node scripts/check-coverage.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "busboy": "1.6.0",
    "fflate": "0.8.3",
    "iron-session": "8.0.4",
    "katex": "0.19.0",
    "lucide-react": "0.468.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "katex": "0.19.0",
    "esbuild": "$esbuild"
  }
}
