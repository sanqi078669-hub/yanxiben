# All values are optional. No credentials are included.
# Next dev/start loads .env.local; tsx CLI scripts use shell environment variables.
# Default: ./data. Use a separate empty folder for restore / test instances.
# DATA_DIR=C:/path/to/private-data

# Session key defaults to DATA_DIR/session-secret, created by npm run init.
# SESSION_SECRET must be >=32 characters if explicitly configured; keep it private.
# SESSION_SECRET=
# SESSION_COOKIE_NAME=yanxi_session
# Set only behind a separately configured HTTPS deployment, not local HTTP.
# SECURE_COOKIES=1

# AI profiles / API keys are configured in the settings page, not this file.
# Optional encryption master-key file OUTSIDE DATA_DIR; never commit / share it.
# AI_KEY_FILE=C:/path/to/separate-secrets/ai-master.key

# CLI initialization only (set in PowerShell; existing account passwords stay unchanged).
# INIT_USERNAME=student
# INIT_PASSWORD=

# Invited production instance (see docs/DEPLOYMENT.md). Not required for local HTTP.
# PUBLIC_ORIGIN=https://study.example.org
# YANXI_DEPLOYMENT=invited # required for invited HTTPS; startup rejects missing protection settings
# PROXY_SECRET= # >=32 characters; same secret injected/overwritten by local Caddy
# RESTORE_MODE=admin
# CAPACITY_POLICY=invited
# AI_ENABLED=0

# Export cache budgets apply to new tasks; valid keys replay for 7 days.
# Single application process owns reservations and the rolling rate window.
# EXPORT_CACHE_ACCOUNT_BYTES=268435456
# EXPORT_CACHE_INSTANCE_BYTES=1879048192
# EXPORT_CACHE_ACCOUNT_FILES=12
# EXPORT_CACHE_INSTANCE_FILES=84
# EXPORT_CACHE_RATE_COUNT=3
# EXPORT_CACHE_RATE_WINDOW_MS=300000
# EXPORT_CACHE_MIN_FREE_BYTES=5368709120
# EXPORT_CACHE_CLEANUP_MS=60000
